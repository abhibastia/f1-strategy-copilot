# Copy to .env for local development. Do NOT commit a filled-in .env.
#
# There are NO API KEYS in this project. Jolpica-F1, Wikimedia and Open-Meteo
# are all free and keyless — the only credential is the Lakebase connection URL,
# which lives in a Databricks secret and is never stored here.

DATABRICKS_CONFIG_PROFILE=DEFAULT

# Where the Postgres connection URL lives (names only, never the value)
LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

# Escape hatch for running against a plain Postgres with no Databricks auth.
# Leave unset in normal use so the secret scope is used.
# LAKEBASE_URL=postgresql://role:password@host:5432/databricks_postgres?sslmode=require

# Must match the model that built the stored vectors, or search returns nonsense
# rather than erroring.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
HF_HOME=/tmp/.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/tmp/.cache/huggingface

# Race spine: the medallion project's landing files (season/round/circuit/url)
F1_LANDING_DIR=~/Projects/formula1-capstone-project/landing

# Wikipedia's User-Agent policy requires a contact route; anonymous-looking
# clients are throttled hard (HTTP 429 after ~10 requests).
WIKI_USER_AGENT=f1-strategy-copilot/1.0 (https://github.com/<you>/f1-strategy-copilot) contact via GitHub issues

# NWS is not used by this project; Open-Meteo needs no identification.
