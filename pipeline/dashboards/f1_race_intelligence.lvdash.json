{
  "datasets": [
    {
      "name": "ds_championship",
      "displayName": "Championship progression",
      "queryLines": [
        "SELECT season, round, race_date, race_name, driver_id, driver_name,\n",
        "       constructor_name_as_of_race AS constructor, cumulative_points,\n",
        "       championship_position, gap_to_leader, points_gained_in_round,\n",
        "       position_change_vs_prev_round\n",
        "FROM championship_progression"
      ]
    },
    {
      "name": "ds_driver_perf",
      "displayName": "Driver performance",
      "queryLines": [
        "SELECT season, round, race_date, race_name, circuit_name, circuit_country,\n",
        "       driver_id, driver_name, driver_code,\n",
        "       constructor_name_as_of_race AS constructor,\n",
        "       grid_position, finish_position, positions_gained,\n",
        "       race_points, sprint_points, total_points, laps_completed,\n",
        "       status, dnf_flag, is_win, is_podium, is_points_finish,\n",
        "       quali_position, quali_to_finish_delta\n",
        "FROM driver_performance"
      ]
    },
    {
      "name": "ds_driver_season",
      "displayName": "Driver season summary",
      "queryLines": [
        "SELECT season, driver_name, constructor_name_as_of_race AS constructor,\n",
        "       COUNT(*)                                    AS races,\n",
        "       SUM(total_points)                           AS points,\n",
        "       SUM(CASE WHEN is_win THEN 1 ELSE 0 END)     AS wins,\n",
        "       SUM(CASE WHEN is_podium THEN 1 ELSE 0 END)  AS podiums,\n",
        "       ROUND(AVG(finish_position), 2)              AS avg_finish,\n",
        "       SUM(positions_gained)                       AS net_positions_gained,\n",
        "       ROUND(100.0 * SUM(CASE WHEN dnf_flag THEN 1 ELSE 0 END) / COUNT(*), 1) AS dnf_rate_pct\n",
        "FROM driver_performance\n",
        "GROUP BY season, driver_name, constructor_name_as_of_race"
      ]
    },
    {
      "name": "ds_constructor_season",
      "displayName": "Constructor season points",
      "queryLines": [
        "SELECT season, constructor_name_as_of_race AS constructor,\n",
        "       SUM(total_points) AS points,\n",
        "       SUM(CASE WHEN is_win THEN 1 ELSE 0 END) AS wins\n",
        "FROM driver_performance\n",
        "WHERE constructor_name_as_of_race IS NOT NULL\n",
        "GROUP BY season, constructor_name_as_of_race"
      ]
    },
    {
      "name": "ds_dq",
      "displayName": "Data quality by run",
      "queryLines": [
        "WITH e AS (\n",
        "  SELECT origin.update_id AS update_id, timestamp AS event_time,\n",
        "         origin.flow_name AS dataset_name,\n",
        "         explode(from_json(\n",
        "           get_json_object(details, '$.flow_progress.data_quality.expectations'),\n",
        "           'ARRAY<STRUCT<name STRING, passed_records BIGINT, failed_records BIGINT>>'\n",
        "         )) AS x\n",
        "  FROM pipeline_event_log\n",
        "  WHERE event_type = 'flow_progress'\n",
        "    AND get_json_object(details, '$.flow_progress.data_quality.expectations') IS NOT NULL\n",
        ")\n",
        "SELECT dataset_name, x.name AS expectation_name,\n",
        "       SUM(x.passed_records) AS passed_records,\n",
        "       SUM(x.failed_records) AS failed_records,\n",
        "       MAX(event_time)       AS last_run\n",
        "FROM e GROUP BY dataset_name, x.name"
      ]
    }
  ],
